# Auto-detect text files and normalize line endings to LF
* text=auto

# Explicit text files
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.plist text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Executable launcher
bookhunt text eol=lf

# Binary files
*.icns binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.epub binary
*.zip binary
